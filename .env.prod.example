IMAGE_TAG=latest

POSTGRES_HOST=postgres
POSTGRES_DB=tutoragent
POSTGRES_USER=tutoragent
POSTGRES_PASSWORD=

MOODLE_WWWROOT=https://moodle.norialabs.com
MOODLE_PORT=8080
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_EMAIL=admin@norialabs.com
DEMO_PASSWORD=
MOODLE_DEBUG=0
MOODLE_SSLPROXY=1

# Moodle shows "Don't miss out on important updates and security alerts" on every
# admin page until the site is registered with moodle.org. 0 turns that off via
# $CFG->site_is_public, which in core gates nothing but registration itself.
# Set to 1 if you do want to register the site.
MOODLE_REGISTRATION_PROMPT=0

# Seed the demo courses on every start. 0 leaves the site empty.
SEED_ON_START=1

# No demo teacher and no demo students on a real site. The courses, categories
# and activities are still seeded; the only account is the administrator above.
SEED_USERS=0

# The teacher on every course, created even though the demo students are not.
# Set these to a real person before deploying. MOODLE_TEACHER_PASSWORD falls
# back to DEMO_PASSWORD; give the teacher its own if the two should differ.
MOODLE_TEACHER_USER=teacher
MOODLE_TEACHER_FIRSTNAME=Course
MOODLE_TEACHER_LASTNAME=Teacher
MOODLE_TEACHER_EMAIL=teacher@example.com
MOODLE_TEACHER_PASSWORD=

RECOMMENDER_THRESHOLD=0.45
