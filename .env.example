DEMO_PASSWORD=Demo@2026!
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_EMAIL=admin@example.com

# MOODLE_WWWROOT must match the address you type in the browser, port
# included, or Moodle redirects in a loop.
MOODLE_PORT=8080
MOODLE_WWWROOT=http://localhost:8080

# 1 shows PHP notices on the page; applies on restart.
MOODLE_DEBUG=0

# The demo courses are seeded on every container start. Safe to repeat: missing
# things are created, courses and activities are brought into line with
# seed_demo.php, and existing users and learning styles are left alone. Set to 0
# to leave the site empty.
SEED_ON_START=1

RECOMMENDER_PORT=8000
# Below this confidence, fall back to a keyword lookup.
RECOMMENDER_THRESHOLD=0.45

POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=moodle_demo_pw
