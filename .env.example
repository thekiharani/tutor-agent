# Copy to .env before the first `make up`.  `make up` does this for you if .env
# is missing.  Nothing here is secret: it is a throwaway local demo.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=moodle_demo_pw

# --- Moodle -----------------------------------------------------------------
# MOODLE_WWWROOT must match the address you type in the browser, port included,
# or Moodle will redirect you in a loop.
MOODLE_PORT=8080
MOODLE_WWWROOT=http://localhost:8080
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=Admin#2026demo
MOODLE_ADMIN_EMAIL=admin@example.com
# 0 hides PHP notices from the page (use this for the demo), 1 shows them
# on screen (use this while editing the plugin). Takes effect on restart.
MOODLE_DEBUG=0

# --- Recommender ------------------------------------------------------------
RECOMMENDER_PORT=8000
# Below this confidence the service falls back to a keyword lookup (WP1).
RECOMMENDER_THRESHOLD=0.45

# --- Demo accounts (created by `make seed`) ---------------------------------
DEMO_STUDENT_PASS=Student#2026demo
